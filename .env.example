# ==========================================
# ISAAC AI - ENVIRONMENT VARIABLES CONFIGURATION
# ==========================================

# ------------------------------------------
# 1. OpenRouter AI Inference Provider (REQUIRED)
# ------------------------------------------
# Get your API key from https://openrouter.ai/keys
# Never share or expose this key to client-side code!
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"

# Configurable OpenRouter model identifier (Default: qwen/qwen-2.5-72b-instruct)
# Supported options include:
# - qwen/qwen-2.5-72b-instruct
# - qwen/qwen3-235b-a22b
# - qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_MODEL="qwen/qwen-2.5-72b-instruct"

# Structured Observability & AI Pipeline Debugging
# Set to true for detailed step-by-step console logs & timing metrics.
# Set to false for clean production warnings/errors only.
AI_DEBUG=true
NEXT_PUBLIC_AI_DEBUG=true

# ------------------------------------------
# 2. Database Connection - Supabase PostgreSQL (REQUIRED)
# ------------------------------------------
# DATABASE_URL is used by Prisma Client to connect to Supabase PostgreSQL database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.wrawresudihjvhcviqfo.supabase.co:5432/postgres?sslmode=require"

# DIRECT_URL is used by Prisma CLI / Migrations for direct connection
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.wrawresudihjvhcviqfo.supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------
# 3. NextAuth Authentication (REQUIRED)
# ------------------------------------------
# Secret key for signing NextAuth session JWTs
AUTH_SECRET="c5c833d0fb8181d8c60bbe8e932a438908eb62bdc192f8ff8004261098e7c282"

# Base URL of the application
AUTH_URL="http://localhost:3000"

# ------------------------------------------
# 4. OAuth Providers (OPTIONAL)
# ------------------------------------------
GOOGLE_CLIENT_ID="mock_google_id"
GOOGLE_CLIENT_SECRET="mock_google_secret"

GITHUB_CLIENT_ID="mock_github_id"
GITHUB_CLIENT_SECRET="mock_github_secret"

AUTH_DEBUG=false
NEXTAUTH_DEBUG=false
